# Normalization
def normalize_counts(expression_matrix):
    library_sizes = expression_matrix.sum(axis=0)

    cpm = expression_matrix.div(
        library_sizes,
        axis=1
    ) * 1_000_000

    log_cpm = np.log2(cpm + 1)

    return log_cpm
